<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="Storage">

        <EditTextPreference
            android:key="storage_location"
            android:title="Save location"
            android:summary="/storage/emulated/0/DCIM/ScreenRecorder (default)"
            android:dialogTitle="Storage folder"
            android:dialogMessage="Absolute path where recordings &amp; screenshots are saved"
            android:defaultValue="/storage/emulated/0/DCIM/ScreenRecorder" />

        <Preference
            android:key="create_dirs"
            android:title="Create storage folders"
            android:summary="Create the default ScreenRecorder/Recordings &amp; Screenshots folders if missing" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Appearance">

        <ListPreference
            android:key="theme_mode"
            android:title="Theme"
            android:summary="Dark mode / light mode / follow system"
            android:entries="@array/theme_options"
            android:entryValues="@array/theme_values"
            android:defaultValue="system" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Quick-access bubble">

        <ListPreference
            android:key="bubble_size"
            android:title="Bubble size"
            android:summary="How big the quick-access bubble is"
            android:entries="@array/bubble_sizes"
            android:entryValues="@array/bubble_size_values"
            android:defaultValue="44" />

        <ListPreference
            android:key="bubble_colour"
            android:title="Bubble colour"
            android:summary="Colour of the quick-access bubble"
            android:entries="@array/bubble_colours"
            android:entryValues="@array/bubble_colour_values"
            android:defaultValue="0xE61565C0" />

        <SwitchPreference
            android:key="bubble_auto_show"
            android:title="Show bubble on app open"
            android:summary="Automatically show the bubble when the app starts (if overlay granted)"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Audio">

        <SwitchPreference
            android:key="record_audio"
            android:title="Record audio"
            android:summary="Capture sound with the video"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="record_mic"
            android:title="Record microphone"
            android:summary="Capture your voice via the mic (turn off for device audio only)"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="audio_noise_suppression"
            android:title="Noise suppression"
            android:summary="Reduce background noise while recording (Android 10+ recommended)"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="audio_echo_cancel"
            android:title="Echo cancellation"
            android:summary="Reduce echo from speakers while recording"
            android:defaultValue="true" />

        <ListPreference
            android:key="audio_bitrate"
            android:title="Audio quality"
            android:summary="Audio bitrate (higher = better, larger file)"
            android:entries="@array/audio_bitrates"
            android:entryValues="@array/audio_bitrate_values"
            android:defaultValue="128000" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Video">

        <ListPreference
            android:key="video_resolution"
            android:title="Resolution"
            android:summary="Video resolution"
            android:entries="@array/resolutions"
            android:entryValues="@array/resolution_values"
            android:defaultValue="screen" />

        <ListPreference
            android:key="video_fps"
            android:title="Frame rate"
            android:summary="Frames per second"
            android:entries="@array/fps_options"
            android:entryValues="@array/fps_values"
            android:defaultValue="30" />

        <ListPreference
            android:key="video_bitrate"
            android:title="Video bitrate"
            android:summary="Video quality (higher = better, larger file)"
            android:entries="@array/video_bitrates"
            android:entryValues="@array/video_bitrate_values"
            android:defaultValue="8000000" />

        <SwitchPreference
            android:key="video_orientation_lock"
            android:title="Lock orientation"
            android:summary="Record in the current screen orientation without auto-rotating"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Capture &amp; overlay">

        <SwitchPreference
            android:key="show_screenshot_button"
            android:title="Show screenshot button"
            android:summary="Toggle the screenshot capture option in the bubble"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="record_streams"
            android:title="Record streaming video (non-DRM)"
            android:summary="Enables capture of non-protected streams (Twitch, YouTube web, self-hosted)"
            android:defaultValue="true" />

        <Preference
            android:key="drm_note"
            android:title="About DRM-protected content"
            android:summary="Netflix, Prime Video, Disney+ and other DRM apps cannot be recorded — the OS blocks capture at the hardware level." />

    </PreferenceCategory>

    <PreferenceCategory android:title="About">

        <Preference
            android:key="about"
            android:title="About J~Net Screen Recorder"
            android:summary="Made by jnetai.com" />

        <Preference
            android:key="check_update"
            android:title="Check for update"
            android:summary="Check the latest GitHub release" />

        <Preference
            android:key="share"
            android:title="Share app"
            android:summary="Share a link to the latest release" />

    </PreferenceCategory>
</PreferenceScreen>
