<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bubble_panel_bg"
    android:padding="8dp">

    <ImageButton
        android:id="@+id/btn_record"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/round_btn_red"
        android:src="@drawable/ic_record"
        android:contentDescription="@string/start_recording"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:layout_marginBottom="6dp" />

    <ImageButton
        android:id="@+id/btn_stop"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/round_btn_dark"
        android:src="@drawable/ic_stop"
        android:contentDescription="@string/stop_recording"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:layout_marginBottom="6dp" />

    <ImageButton
        android:id="@+id/btn_screenshot"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/round_btn_dark"
        android:src="@drawable/ic_camera"
        android:contentDescription="@string/take_screenshot"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:layout_marginBottom="6dp" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/round_btn_dark"
        android:src="@drawable/ic_gear"
        android:contentDescription="@string/open_settings"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:layout_marginBottom="6dp" />

    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/round_btn_dark"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/hide_bubble"
        android:scaleType="fitCenter"
        android:padding="12dp" />
</LinearLayout>
