<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="green_text">#9CCC65</color>

    <style name="Theme.ScreenRecorder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Dark theme with light-green text, used by default for the Settings screen -->
    <style name="Theme.ScreenRecorder.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/green_text</item>
        <item name="colorPrimaryDark">#1B5E20</item>
        <item name="colorAccent">@color/green_text</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:textColor">@color/green_text</item>
        <item name="android:textColorPrimary">@color/green_text</item>
        <item name="android:textColorSecondary">#AED581</item>
    </style>
</resources>
